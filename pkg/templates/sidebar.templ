package templates

import (
	"calendorario/pkg/database"
	"calendorario/routes"
)

type SidebarRow struct {
	FAIcon   string
	Label    string
	Href     string
	Selected bool
}

templ Sidebar(rows []SidebarRow, currentTerm database.Term) {
	<aside class="fixed left-0 top-0 z-10 h-full w-64 translate-x-0 transition-transform">
		<nav class="h-full space-y-4 p-4">
			<a
				class="clickable h-16 w-full flex flex-row items-center gap-2 rounded-md pr-4 text-start"
				href={ routes.RouteAdmin }
			>
				<div class="button flex-none bg-surface-high px-2">
					<i class="fas fa-arrow-left"></i>
				</div>
				<div class="w-full truncate">
					<p class="text-on-surface-dim text-sm">
						Periodo scolastico
					</p>
					<p class="truncate font-bold">
						{ currentTerm.Name }
					</p>
				</div>
			</a>
			<ul class="space-y-1">
				for _, row := range rows {
					<li>
						<a
							class={
								templ.KV("bg-primary-container", row.Selected),
								templ.KV("clickable font-normal", !row.Selected),
								"button h-12 px-3 w-full justify-start",
							}
							if !row.Selected {
								href={ row.Href }
							}
						>
							<i class={ row.FAIcon, " fas" }></i>
							{ row.Label }
						</a>
					</li>
				}
			</ul>
		</nav>
	</aside>
	<div class="bg-surface fixed left-64 top-0 -z-50 h-full w-full rounded-tl-lg shadow-sm"></div>
}

templ SidebarScaffold(
	rows []SidebarRow,
	currentTerm database.Term,
	content templ.Component,
) {
	<!DOCTYPE html>
	<html>
		@Head()
		<body>
			@Sidebar(rows, currentTerm)
			<main class="ml-64 flex h-full flex-row gap-8 rounded-tl-lg p-4">
				@content
			</main>
		</body>
	</html>
}
